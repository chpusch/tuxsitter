#: src/tuxsitter/gui.py:860
msgid "Restricted Mode hides videos that are not suitable for children."
msgstr "El modo restringido oculta los vídeos no aptos para niños."

#: src/tuxsitter/gui.py:863
msgid "Block workarounds"
msgstr "Bloquear métodos de evasión"

#: src/tuxsitter/gui.py:864
msgid "Blocks known third-party DNS services. Unknown services and VPNs are only recognised by a strict filter such as CleanBrowsing or OpenDNS."
msgstr "Bloquea los servicios DNS de terceros conocidos. Solo un filtro estricto como CleanBrowsing u OpenDNS reconoce servicios desconocidos y VPN."

#: src/tuxsitter/gui.py:868
msgid "Lock DNS settings in browsers"
msgstr "Bloquear la configuración DNS de los navegadores"

#: src/tuxsitter/gui.py:869
msgid "Firefox, Chrome, Chromium, Brave, Edge and Vivaldi can no longer use their own DNS. Applies to all accounts on this computer - for you nothing changes in practice."
msgstr "Firefox, Chrome, Chromium, Brave, Edge y Vivaldi ya no pueden usar su propio DNS. Se aplica a todas las cuentas de este ordenador; para ti, en la práctica, no cambia nada."

