#, python-brace-format
msgid "Too many attempts. Please try again in {time}."
msgstr "Demasiados intentos. Vuelve a intentarlo en {time}."

#: src/tuxsitter/common.py:260
msgid "No parent PIN has been set yet."
msgstr "Aún no se ha definido un PIN parental."

#: src/tuxsitter/common.py:261
msgid "Wrong PIN."
msgstr "PIN incorrecto."

#: src/tuxsitter/common.py:262
msgid "Permission denied."
msgstr "Permiso denegado."

#: src/tuxsitter/common.py:263
msgid "Unknown child."
msgstr "Niño desconocido."

#: src/tuxsitter/common.py:264
msgid "Unknown command."
msgstr "Comando desconocido."

#: src/tuxsitter/common.py:265
msgid "Internal error."
msgstr "Error interno."

#: src/tuxsitter/common.py:266
msgid "The Tuxsitter service is not reachable."
msgstr "No se puede contactar con el servicio Tuxsitter."

#: src/tuxsitter/common.py:267
msgid "Invalid NextDNS profile ID."
msgstr "ID de perfil de NextDNS no válido."

#: src/tuxsitter/common.py:268
msgid "Invalid DNS server address."
msgstr "Dirección de servidor DNS no válida."

#: src/tuxsitter/common.py:269
msgid "The filter did not return an address."
msgstr "El filtro no devolvió ninguna dirección."

#: src/tuxsitter/common.py:270
msgid "Please confirm with your password first."
msgstr "Primero confirma con tu contraseña."

#: src/tuxsitter/common.py:271
msgid "Authentication failed."
msgstr "Error de autenticación."

#: src/tuxsitter/common.py:272
msgid "The password check (polkit) is not available on this system."
msgstr "La comprobación de contraseña (polkit) no está disponible en este sistema."

#: src/tuxsitter/common.py:273
msgid "Invalid or already existing username."
msgstr "Nombre de usuario no válido o ya existente."

#: src/tuxsitter/common.py:274
msgid "The password must have at least 4 characters."
msgstr "La contraseña debe tener al menos 4 caracteres."

#: src/tuxsitter/common.py:275
msgid "The account could not be created."
msgstr "No se pudo crear la cuenta."

#: src/tuxsitter/common.py:36
msgid "Blocks adult content and malware, but not VPNs or other DNS services. Free and very fast."
msgstr "Bloquea contenido para adultos y malware, pero no VPN ni otros servicios DNS. Gratis y muy rápido."

#: src/tuxsitter/common.py:41
msgid "Stricter: also blocks VPNs, proxies and other DNS services that could bypass the filter, and sites like Reddit. Recommended for older children. Free."
msgstr "Más estricto: también bloquea VPN, proxies y otros servicios DNS con los que se podría eludir el filtro, así como sitios como Reddit. Recomendado para niños mayores. Gratis."

#: src/tuxsitter/common.py:46
msgid "Blocks adult content and also ads. Free."
msgstr "Bloquea contenido para adultos y también publicidad. Gratis."

#: src/tuxsitter/common.py:51
msgid "Recommended: blocks adult content and also VPNs, proxies and other DNS services that could bypass the filter. Free."
msgstr "Recomendado: bloquea contenido para adultos y también VPN, proxies y otros servicios DNS con los que se podría eludir el filtro. Gratis."

#: src/tuxsitter/common.py:55
msgid "NextDNS (your own profile)"
msgstr "NextDNS (tu propio perfil)"

#: src/tuxsitter/common.py:56
msgid "Configure everything yourself at my.nextdns.io and enter the profile ID here."
msgstr "Configura todo tú mismo en my.nextdns.io e introduce aquí el ID del perfil."

#: src/tuxsitter/common.py:60
msgid "Custom DNS server"
msgstr "Servidor DNS personalizado"

#: src/tuxsitter/common.py:61
msgid "IP address(es) of your own filter, e.g. Pi-hole. Separate several with commas."
msgstr "Dirección(es) IP de tu propio filtro, p. ej. Pi-hole. Sepáralas con comas."

